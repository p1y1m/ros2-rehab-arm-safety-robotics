<?xml version="1.0"?>
<robot name="rehab_arm">
  <material name="medical_blue">
    <color rgba="0.15 0.45 0.75 1"/>
  </material>
  <material name="soft_gray">
    <color rgba="0.65 0.68 0.72 1"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.18" length="0.10"/></geometry>
      <material name="soft_gray"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.18" length="0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0447" ixy="0" ixz="0" iyy="0.0447" iyz="0" izz="0.0810"/>
    </inertial>
  </link>

  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.30"/>
      <geometry><cylinder radius="0.055" length="0.60"/></geometry>
      <material name="medical_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.30"/>
      <geometry><cylinder radius="0.055" length="0.60"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.30"/>
      <mass value="1.5"/>
      <inertia ixx="0.0461" ixy="0" ixz="0" iyy="0.0461" iyz="0" izz="0.00227"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><cylinder radius="0.045" length="0.50"/></geometry>
      <material name="soft_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry><cylinder radius="0.045" length="0.50"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="1.0"/>
      <inertia ixx="0.02134" ixy="0" ixz="0" iyy="0.02134" iyz="0" izz="0.001013"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.60"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.35" effort="30" velocity="1.2"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_joint</joint_name>
      <topic>/shoulder_position</topic>
      <p_gain>100.0</p_gain>
      <i_gain>20.0</i_gain>
      <d_gain>20.0</d_gain>
      <i_max>15.0</i_max>
      <i_min>-15.0</i_min>
      <cmd_max>50.0</cmd_max>
      <cmd_min>-50.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name>
      <topic>/elbow_position</topic>
      <p_gain>50.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>5.0</d_gain>
      <i_max>5.0</i_max>
      <i_min>-5.0</i_min>
      <cmd_max>30.0</cmd_max>
      <cmd_min>-30.0</cmd_min>
    </plugin>
  </gazebo>
</robot>
